<!DOCTYPE html>
<html lang="">
  <head>
    <meta charset="UTF-8">
    <link rel="icon" href="/favicon.ico">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link src="https://unpkg.com/vue@3/dist/vue.global.jsscript" >
    <title>Vite App</title>
  </head>
  <body>
    <!-- <div id="app"></div>
     <script type="module" src="/src/main.ts"></script> -->

    <div id="app">
      <h1>{{ mensagem }}</h1>

      <input v-model="mensagem">

      <button @click="contador++">
        Cliques: {{ contador }}
      </button>



        <script>
        const { createApp } = Vue;

        createApp({
          data() {
            return {
              mensagem: "Olá Vue.js!",
              contador: 0
            }
          }
        }).mount("#app");
        </script>
    </div>
  </body>
</html>
